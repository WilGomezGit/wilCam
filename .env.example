# ── Core ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
CORS_ORIGIN=http://localhost

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_in_production_min_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Database ───────────────────────────────────────────────────────────────
DB_PATH=./wilcam.db

# ── Storage paths ──────────────────────────────────────────────────────────
HLS_OUTPUT_DIR=./public/hls
RECORDINGS_DIR=./public/recordings
SNAPSHOTS_DIR=./public/snapshots

# ── FFmpeg ─────────────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI Microservice ────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_CONFIDENCE=0.5
AI_DEVICE=cpu

# ── AWS S3 ─────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=wilcam-recordings
AWS_CLOUDFRONT_URL=

# ── Firebase Cloud Messaging ───────────────────────────────────────────────
FCM_SERVER_KEY=
FIREBASE_PROJECT_ID=

# ── Multi-tenant ───────────────────────────────────────────────────────────
DEFAULT_ORG_NAME=WilCam Default

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ── Security ───────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=10

# ── Feature flags ──────────────────────────────────────────────────────────
AUTO_START_STREAMS=true
ENABLE_AI=true
ENABLE_S3=false
ENABLE_WEBRTC=false
ENABLE_PUSH_NOTIFICATIONS=false
